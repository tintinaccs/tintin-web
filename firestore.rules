rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ============================================================
       TINTIN — HELPERS BASE
       ============================================================ */

    function isSignedIn() {
      return request.auth != null;
    }

    // El lenguaje de reglas no admite imports ni constantes compartidas
    // entre archivos, así que este literal se repite en cada función que lo
    // necesita en todo el archivo (js/roles.js y cloudflare/cloudinary-
    // security.js sí tienen una única fuente de verdad cada uno, para sus
    // respectivos runtimes). Migrar a un custom claim de Firebase Auth
    // (admin=true) eliminaría la comparación por correo acá también, pero
    // requiere el Admin SDK en un entorno privilegiado — ver
    // firebase-cloud-functions-inactive/README.md.
    function isSuperAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == "tintinaccs@gmail.com";
    }

    function userDocExists() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentRole() {
      return userDocExists()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : "client";
    }

    function hasRole(role) {
      return isSignedIn() &&
        !isBlockedUser() &&
        userDocExists() &&
        currentRole() == role;
    }

    function isBlockedUser() {
      return isSignedIn() &&
        !isSuperAdmin() &&
        userDocExists() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.blocked == true;
    }

    function isAdmin() {
      return isSignedIn() && !isBlockedUser() && (
        isSuperAdmin() || hasRole("admin")
      );
    }

    function isAgent() {
      return hasRole("agent");
    }

    function isViewer() {
      return hasRole("viewer");
    }

    function isSuperAdminAccount(data) {
      return data.email is string &&
        data.email.lower() == "tintinaccs@gmail.com";
    }

    /* ============================================================
       TINTIN — TIENDA ACTIVA / CERRADA
       ============================================================ */

    function isStoreOpenOrAllowed() {
      // Si settings/storeGate todavía no existe (recién desplegado el
      // cierre y el Super Admin todavía no guardó Configuración una vez
      // para crear el documento), no hay nada que evaluar todavía: se
      // permite el acceso normal en vez de bloquear el sitio entero por un
      // documento que nunca llegó a crearse. Apenas el documento existe,
      // manda por completo su storeOpen/maintenanceAccess como antes.
      return isSuperAdmin() ||
        (
          !isBlockedUser() &&
          (
            !exists(/databases/$(database)/documents/settings/storeGate) ||
            get(/databases/$(database)/documents/settings/storeGate).data.storeOpen == true ||
            (
              get(/databases/$(database)/documents/settings/storeGate).data.maintenanceAccess is map &&
              get(/databases/$(database)/documents/settings/storeGate).data.maintenanceAccess
                .get(isSignedIn() ? currentRole() : 'guest', false) == true
            )
          )
        );
    }

    /* ============================================================
       TINTIN — ROLES Y PERMISOS DINÁMICOS
       ============================================================ */

    /* Actividad anónima: puede guardar ciudad/región/país aproximados, pero
       nunca IP, GPS, coordenadas, código postal, navegador, nombre ni correo.
       Solo Super Admin puede leer las sesiones y la presencia. */
    function activityUserIdIsValid(data) {
      return data.userId is string &&
        data.userId.size() <= 128 &&
        (
          data.userId == '' ||
          (isSignedIn() && data.userId == request.auth.uid)
        );
    }

    function activityGeoIsValid(data) {
      return data.get('city', '') is string && data.get('city', '').size() <= 80 &&
        data.get('region', '') is string && data.get('region', '').size() <= 80 &&
        data.get('country', '') is string && data.get('country', '').size() <= 80 &&
        data.get('countryCode', '') is string &&
        data.get('countryCode', '').matches('^$|^[A-Z]{2}$') &&
        data.get('geoSource', '') is string &&
        data.get('geoSource', '').matches('^$|^netlify$|^unavailable$');
    }

    function presenceIsValid(visitorId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'visitorId', 'sessionId', 'userId', 'page', 'lastSeen'
        ]) &&
        data.keys().hasOnly([
          'visitorId', 'sessionId', 'userId', 'page', 'lastSeen',
          'city', 'region', 'country', 'countryCode', 'geoSource'
        ]) &&
        data.visitorId == visitorId &&
        data.visitorId is string && data.visitorId.size() >= 8 && data.visitorId.size() <= 80 &&
        data.sessionId is string && data.sessionId.size() >= 8 && data.sessionId.size() <= 80 &&
        activityUserIdIsValid(data) &&
        activityGeoIsValid(data) &&
        data.page is string && data.page.size() >= 1 && data.page.size() <= 160 &&
        data.lastSeen == request.time;
    }

    function trafficSessionIsValid(dateKey, sessionId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'dayKey', 'sessionId', 'visitorId', 'userId', 'landingPage', 'startedAt'
        ]) &&
        data.keys().hasOnly([
          'dayKey', 'sessionId', 'visitorId', 'userId', 'landingPage', 'startedAt',
          'city', 'region', 'country', 'countryCode', 'geoSource'
        ]) &&
        data.dayKey == dateKey &&
        data.dayKey is string && data.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.sessionId == sessionId &&
        data.sessionId is string && data.sessionId.size() >= 8 && data.sessionId.size() <= 80 &&
        data.visitorId is string && data.visitorId.size() >= 8 && data.visitorId.size() <= 80 &&
        activityUserIdIsValid(data) &&
        activityGeoIsValid(data) &&
        data.landingPage is string && data.landingPage.size() >= 1 && data.landingPage.size() <= 160 &&
        data.startedAt == request.time;
    }

    // El heartbeat de presencia real (site-activity.js) manda cada 60s. Un
    // script que reescriba el mismo documento en bucle sin este freno agota
    // la cuota diaria de escrituras del plan gratuito (Spark/Blaze) — el
    // mismo incidente que llevó a cerrar esta colección por completo antes.
    // Reactivada con este freno + Firebase App Check (bloquea scripts que no
    // sean el sitio real) en vez de mantenerla apagada indefinidamente.
    function presenceUpdateNotTooFrequent() {
      return resource.data.lastSeen is timestamp &&
        request.time > resource.data.lastSeen + duration.value(20, 's');
    }

    match /sitePresence/{visitorId} {
      allow read, delete: if isSuperAdmin();
      allow create: if isStoreOpenOrAllowed() && presenceIsValid(visitorId);
      allow update: if isStoreOpenOrAllowed() &&
        presenceIsValid(visitorId) &&
        presenceUpdateNotTooFrequent();
    }

    match /siteTraffic/{dateKey}/sessions/{sessionId} {
      allow read, delete: if isSuperAdmin();
      allow create: if isStoreOpenOrAllowed() && trafficSessionIsValid(dateKey, sessionId);
      allow update: if false;
    }

    // Conteo agregado de visitas del día, sin identificar a nadie (sin
    // visitorId, geografía ni página) — por eso puede aceptar la visita de
    // cualquier persona sin depender del consentimiento de estadísticas que
    // sí exige sitePresence/siteTraffic (esos guardan detalle por persona).
    function aggregateVisitCreateValid(dayKey) {
      let data = request.resource.data;
      return data.keys().hasOnly(['dayKey', 'totalVisits', 'updatedAt']) &&
        data.dayKey == dayKey &&
        data.dayKey is string && data.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.totalVisits == 1 &&
        data.updatedAt == request.time;
    }

    function aggregateVisitUpdateValid() {
      let data = request.resource.data;
      return data.keys().hasOnly(['dayKey', 'totalVisits', 'updatedAt']) &&
        data.dayKey == resource.data.dayKey &&
        data.totalVisits == resource.data.get('totalVisits', 0) + 1 &&
        data.updatedAt == request.time;
    }

    match /siteAggregate/{dayKey} {
      allow read: if isSuperAdmin();
      allow create: if isStoreOpenOrAllowed() && aggregateVisitCreateValid(dayKey);
      allow update: if isStoreOpenOrAllowed() && aggregateVisitUpdateValid();
      allow delete: if isSuperAdmin();
    }

    function rolePermAllows(role, moduleKey, actionKey) {
      return exists(/databases/$(database)/documents/rolePermissions/main) &&
        get(/databases/$(database)/documents/rolePermissions/main).data
          .get(role, {}).get(moduleKey, {}).get(actionKey, false) == true;
    }

    function currentRolePermAllows(moduleKey, actionKey) {
      return isSignedIn() &&
        !isBlockedUser() &&
        userDocExists() &&
        rolePermAllows(currentRole(), moduleKey, actionKey);
    }

    /* ============================================================
       TINTIN — PEDIDOS / PERFIL
       ============================================================ */

    function isOwnOrderByUidOrEmail() {
      // El checkout hace transaction.get(orderRef) para revisar si ese pedido
      // ya existe (evita duplicados en reintentos) ANTES de crearlo. Para un
      // orderId que todavía no existe, resource es null, y resource.data
      // sobre null revienta la evaluación igual que get(...).data — por eso
      // se permite la lectura cuando el documento no existe todavía (no hay
      // datos ajenos que proteger) en vez de asumir que siempre existe.
      return isSignedIn() && !isBlockedUser() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        (
          resource.data.userEmail is string &&
          request.auth.token.email != null &&
          resource.data.userEmail.lower() == request.auth.token.email.lower()
        )
      );
    }

    function orderStatsOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'purchaseCount', 'orderCount', 'totalOrders', 'totalSpent',
        'completedOrders', 'pendingOrders', 'cancelledOrders',
        'lastOrderAt', 'lastOrderId', 'lastPurchaseAt', 'lastPurchaseOrderId',
        'profileStatsUpdatedAt', 'orderStats', 'updatedAt'
      ]);
    }

    function orderStatsNonNegative() {
      return
        (!('purchaseCount' in request.resource.data) || request.resource.data.purchaseCount >= 0) &&
        (!('orderCount' in request.resource.data) || request.resource.data.orderCount >= 0) &&
        (!('totalOrders' in request.resource.data) || request.resource.data.totalOrders >= 0) &&
        (!('totalSpent' in request.resource.data) || request.resource.data.totalSpent >= 0) &&
        (!('completedOrders' in request.resource.data) || request.resource.data.completedOrders >= 0) &&
        (!('pendingOrders' in request.resource.data) || request.resource.data.pendingOrders >= 0) &&
        (!('cancelledOrders' in request.resource.data) || request.resource.data.cancelledOrders >= 0);
    }

    function loginMetadataOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'lastLogin', 'updatedAt', 'lastAuthMethod', 'authMethods'
      ]) &&
      (!('lastAuthMethod' in request.resource.data) ||
        request.resource.data.lastAuthMethod in ['google', 'emailOtp']) &&
      (!('authMethods' in request.resource.data) ||
        (request.resource.data.authMethods is list &&
          request.resource.data.authMethods.size() >= 1 &&
          request.resource.data.authMethods.size() <= 2 &&
          request.resource.data.authMethods.hasOnly(['google', 'emailOtp'])));
    }

    // Backfill progresivo para perfiles anteriores al contrato de identidad.
    // El cliente solo puede agregar el customerId determinista ligado a SU UID;
    // una vez presente, protectedUserFieldsChanged() impide modificarlo.
    function identityBootstrapOnlyUpdate(userId) {
      let data = request.resource.data;
      return !('customerId' in resource.data) &&
        data.diff(resource.data).affectedKeys().hasOnly([
          'customerId', 'identityVersion', 'profileStatus',
          'lastLogin', 'updatedAt', 'lastAuthMethod', 'authMethods'
        ]) &&
        data.customerId == 'CUS_' + userId &&
        data.identityVersion == 1 &&
        data.profileStatus == 'legacy' &&
        data.lastAuthMethod in ['google', 'emailOtp'] &&
        data.authMethods is list &&
        data.authMethods.size() >= 1 &&
        data.authMethods.size() <= 2 &&
        data.authMethods.hasOnly(['google', 'emailOtp']);
    }

    function checkoutGuardWriteValid(userId) {
      let data = request.resource.data;
      return isSignedIn() &&
        request.auth.uid == userId &&
        data.keys().hasOnly([
          'userId', 'lastCheckoutAt', 'lastCheckoutOrderId', 'updatedAt'
        ]) &&
        data.userId == userId &&
        data.lastCheckoutAt == request.time &&
        data.updatedAt == request.time &&
        data.lastCheckoutOrderId is string &&
        data.lastCheckoutOrderId.size() >= 16 &&
        data.lastCheckoutOrderId.size() <= 260;
    }

    function protectedUserFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'customerId', 'identityVersion', 'profileStatus', 'deleted', 'deletedAt', 'deletedBy',
        'email', 'createdAt', 'provider', 'role', 'blocked', 'blockedAt', 'blockedBy', 'blockReason',
        'roleBeforeBlock', 'purchaseCount', 'orderCount', 'totalOrders',
        'totalSpent', 'completedOrders', 'pendingOrders', 'cancelledOrders',
        'lastOrderAt', 'lastOrderId', 'lastPurchaseAt', 'lastPurchaseOrderId',
        'profileStatsUpdatedAt', 'orderStats', 'lastCheckoutAt', 'lastCheckoutOrderId'
      ]);
    }

    function userProfileFieldsValid() {
      let data = request.resource.data;
      return (!('name' in data) || (data.name is string && data.name.size() <= 120)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2000));
    }

    // Un teléfono no puede estar en dos cuentas, y eso tiene que valer también
    // para quien escriba directo desde la consola del navegador saltándose el
    // formulario. Por eso el número guardado en el perfil sólo se acepta si
    // existe una reserva en `phoneReservations` a nombre de esta misma cuenta
    // (ver js/phone-reservation.js). Sin esta comprobación, la unicidad
    // dependería únicamente del código del cliente, que es modificable.
    //
    // La clave de la reserva es el número sin el '+': '+595981123456' guardado
    // en el perfil corresponde al documento '595981123456'.
    function phoneReservationKey(phone) {
      return phone.replace('^\\+', '');
    }

    function phoneIsReservedByCaller() {
      let data = request.resource.data;
      return !('phone' in data) ||
        data.phone == '' ||
        (
          // Un número sin cambios respecto de lo ya guardado no vuelve a
          // verificarse: evita romper actualizaciones de otros campos (y una
          // lectura extra) en perfiles anteriores a esta regla.
          (resource != null && 'phone' in resource.data && resource.data.phone == data.phone) ||
          (
            exists(/databases/$(database)/documents/phoneReservations/$(phoneReservationKey(data.phone))) &&
            get(/databases/$(database)/documents/phoneReservations/$(phoneReservationKey(data.phone))).data.uid == request.auth.uid
          )
        );
    }

    function userCreateValid(userId) {
      let data = request.resource.data;
      return isSignedIn() &&
        request.auth.uid == userId &&
        request.auth.token.email != null &&
        data.keys().hasOnly([
          'name', 'email', 'customerId', 'identityVersion', 'profileStatus',
          'phone', 'photoURL', 'role', 'provider', 'authMethods', 'lastAuthMethod',
          'onboardingCompleted', 'welcomeTutorialSeen',
          'welcomeTutorialPending', 'welcomeTutorialVersion', 'blocked',
          'purchaseCount', 'totalSpent', 'orderCount', 'totalOrders',
          'completedOrders', 'pendingOrders', 'cancelledOrders',
          'createdAt', 'updatedAt', 'lastLogin'
        ]) &&
        data.email is string &&
        data.email.lower() == request.auth.token.email.lower() &&
        data.customerId == 'CUS_' + userId &&
        data.identityVersion == 1 &&
        data.profileStatus == 'incomplete' &&
        data.lastAuthMethod in ['google', 'emailOtp'] &&
        data.authMethods is list &&
        data.authMethods.size() >= 1 &&
        data.authMethods.size() <= 2 &&
        data.authMethods.hasOnly(['google', 'emailOtp']) &&
        data.get('blocked', false) == false &&
        (
          (isSuperAdmin() && data.get('role', 'superadmin') == 'superadmin') ||
          (!isSuperAdmin() && data.get('role', 'client') == 'client')
        ) &&
        data.get('purchaseCount', 0) == 0 &&
        data.get('totalSpent', 0) == 0 &&
        data.get('orderCount', 0) == 0 &&
        data.get('totalOrders', 0) == 0 &&
        data.get('completedOrders', 0) == 0 &&
        data.get('pendingOrders', 0) == 0 &&
        data.get('cancelledOrders', 0) == 0 &&
        (!('createdAt' in data) || data.createdAt == request.time) &&
        (!('updatedAt' in data) || data.updatedAt == request.time) &&
        (!('lastLogin' in data) || data.lastLogin == request.time) &&
        userProfileFieldsValid();
    }

    function cartItemValid(itemId) {
      let data = request.resource.data;
      let productPath = /databases/$(database)/documents/products/$(data.id);
      return data.keys().hasAll([
          'schemaVersion', 'lineId', 'id', 'variant', 'qty',
          'name', 'cat', 'price', 'imageUrl', 'updatedAt', 'updatedByDevice'
        ]) &&
        data.keys().hasOnly([
          'schemaVersion', 'lineId', 'id', 'variant', 'qty',
          'name', 'cat', 'price', 'imageUrl', 'updatedAt', 'updatedByDevice'
        ]) &&
        data.schemaVersion == 2 &&
        data.lineId == itemId &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 180 &&
        data.variant is string && data.variant.size() <= 120 &&
        data.qty is int && data.qty >= 1 && data.qty <= 99 &&
        data.name is string && data.name.size() <= 180 &&
        data.cat is string && data.cat.size() <= 120 &&
        data.price is number && data.price >= 0 &&
        data.imageUrl is string && data.imageUrl.size() <= 1200 &&
        data.updatedAt == request.time &&
        data.updatedByDevice is string && data.updatedByDevice.size() >= 8 && data.updatedByDevice.size() <= 180 &&
        exists(productPath) &&
        get(productPath).data.get('active', true) != false &&
        (
          !('stock' in get(productPath).data) ||
          get(productPath).data.stock == null ||
          (
            get(productPath).data.stock is number &&
            data.qty <= get(productPath).data.stock
          )
        );
    }

    function favoriteItemValid(productId) {
      let data = request.resource.data;
      let productPath = /databases/$(database)/documents/products/$(productId);
      return data.keys().hasAll([
          'schemaVersion', 'productId', 'name', 'cat', 'price', 'imageUrl', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'schemaVersion', 'productId', 'name', 'cat', 'price', 'imageUrl', 'updatedAt'
        ]) &&
        data.schemaVersion == 1 &&
        data.productId == productId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 180 &&
        data.cat is string && data.cat.size() <= 120 &&
        data.price is number && data.price >= 0 &&
        data.imageUrl is string && data.imageUrl.size() <= 1200 &&
        data.updatedAt == request.time &&
        exists(productPath) &&
        get(productPath).data.get('active', true) != false;
    }

    /* ============================================================
       TINTIN — PEDIDOS SIN BLAZE (SPARK)

       Máximo 4 productos diferentes por pedido para permanecer dentro de los
       límites de lecturas de reglas. Precio y stock se validan contra products.
       ============================================================ */

    function sparkProductPath(productId) {
      return /databases/$(database)/documents/products/$(productId);
    }

    function sparkOrderPath(orderId) {
      return /databases/$(database)/documents/orders/$(orderId);
    }

    function checkoutGuardPath(userId) {
      return /databases/$(database)/documents/checkoutGuards/$(userId);
    }

    function sparkItemQtyForProduct(items, index, productId) {
      return items.size() > index && items[index].id == productId
        ? items[index].qty
        : 0;
    }

    function sparkOrderQtyForProduct(data, productId) {
      let items = data.items;
      return
        sparkItemQtyForProduct(items, 0, productId) +
        sparkItemQtyForProduct(items, 1, productId) +
        sparkItemQtyForProduct(items, 2, productId) +
        sparkItemQtyForProduct(items, 3, productId);
    }

    function sparkOrderHasProduct(data, productId) {
      let items = data.items;
      return
        (items.size() > 0 && items[0].id == productId) ||
        (items.size() > 1 && items[1].id == productId) ||
        (items.size() > 2 && items[2].id == productId) ||
        (items.size() > 3 && items[3].id == productId);
    }

    function sparkItemValid(item, orderId) {
      // Se evalúa hasta 4 veces por escritura (una por cada producto
      // distinto del carrito, el máximo permitido) — cada chequeo extra acá
      // cuenta 4 veces contra el límite de 1000 expresiones que Firestore
      // evalúa por escritura. Con las validaciones que había antes
      // (item.keys().hasOnly(), fallback de nombre a 3 niveles, precio y
      // stock verificados con exists()+get() por separado) un carrito de
      // 3-4 productos distintos superaba ese límite y el pedido se
      // rechazaba siempre, sin ningún aviso claro de la causa. Recortado a
      // lo esencial para el dinero y el inventario (precio real y stock
      // disponible); ya no exige que el nombre mostrado coincida exacto
      // con el del producto ni limita las claves del item — un campo de
      // más o un nombre desactualizado ahí es cosmético, no cambia lo que
      // se cobra ni lo que se descuenta de stock.
      let product = get(/databases/$(database)/documents/products/$(item.id)).data;
      return item is map &&
        item.id is string && item.id.size() > 0 && item.id.size() <= 180 &&
        item.name is string && item.name.size() > 0 && item.name.size() <= 180 &&
        item.price is number && item.price >= 0 &&
        item.qty is int && item.qty >= 1 && item.qty <= 99 &&
        product.get('active', true) != false &&
        product.price == item.price &&
        (product.get('stock', null) == null || product.get('stock', null) >= item.qty);
    }

    function sparkItemAtValid(items, index, orderId) {
      return items.size() <= index || sparkItemValid(items[index], orderId);
    }

    function sparkLineTotal(items, index) {
      return items.size() > index
        ? items[index].price * items[index].qty
        : 0;
    }

    function sparkItemsUnique(items) {
      return
        (items.size() < 2 || items[0].id != items[1].id) &&
        (items.size() < 3 || (items[0].id != items[2].id && items[1].id != items[2].id)) &&
        (items.size() < 4 || (
          items[0].id != items[3].id &&
          items[1].id != items[3].id &&
          items[2].id != items[3].id
        ));
    }

    function sparkRateValueValid(entry, fallback, city, cost, pending) {
      return
        (
          entry is string &&
          city == entry &&
          fallback is number &&
          cost == fallback &&
          pending == false
        ) ||
        (
          entry is map &&
          city == entry.get('name', '') &&
          (
            (
              entry.get('price', fallback) == null &&
              cost == 0 &&
              pending == true
            ) ||
            (
              entry.get('price', fallback) is number &&
              cost == entry.get('price', fallback) &&
              pending == false
            )
          )
        );
    }

    // La carga masiva de departamentos dejó deliveryCities/encomiendaCities
    // con cientos de entradas (una por ciudad de Paraguay). Mientras vivían
    // dentro de settings/general, CUALQUIER pedido — incluido retiro en
    // tienda, que ni usa esas listas — pagaba el costo de materializar el
    // documento entero al hacer settings = get(settingsPath).data, y
    // terminaba superando el límite de 1000 expresiones que Firestore
    // evalúa por escritura (rechazo sin aviso claro de la causa). Viven en
    // su propio documento, settings/shippingRates, para que solo lo lean
    // los pedidos por delivery/encomienda que de verdad lo necesitan.
    function sparkShippingRatesPath() {
      return /databases/$(database)/documents/settings/shippingRates;
    }

    function sparkDeliveryValid(data) {
      let shipping = data.shipping;
      let index = shipping.rateIndex;
      let ratesPath = sparkShippingRatesPath();
      let rates = exists(ratesPath) ? get(ratesPath).data : {};
      let cities = rates.get('deliveryCities', []);
      return cities is list &&
        index is int && index >= 0 && index < cities.size() &&
        sparkRateValueValid(
          cities[index],
          rates.get('deliveryCost', 0),
          shipping.city,
          data.shippingCost,
          data.shippingPending
        );
    }

    // Encomienda no valida la ciudad contra el arreglo de tarifas (a
    // diferencia de delivery, arriba): con la carga masiva de departamentos
    // esa lista pasó a tener ~240 entradas, y solo indexarla (cities[i])
    // ya alcanza el límite de 1000 expresiones por escritura de Firestore
    // por sí solo — no hay margen para sumarle validaciones. Es un riesgo
    // aceptado a propósito: casi todas esas ciudades tienen precio "a
    // confirmar" (costo 0, se negocia por WhatsApp antes de cobrar nada),
    // así que no hay ningún cobro automático que alguien pueda falsear acá
    // — el peor caso es que el equipo tenga que confirmar manualmente el
    // costo real de envío en vez de leerlo ya validado.
    function sparkEncomiendaValid(data) {
      let shipping = data.shipping;
      return shipping.city is string && shipping.city.size() > 0 &&
        data.shippingCost is number &&
        data.shippingCost >= 0 && data.shippingCost <= 500000 &&
        data.shippingPending is bool;
    }

    function sparkMapLocationValid(mapLocation) {
      return mapLocation == null ||
        (
          mapLocation is map &&
          mapLocation.keys().hasOnly(['lat', 'lng', 'name', 'address']) &&
          mapLocation.lat is number &&
          mapLocation.lng is number &&
          mapLocation.name is string &&
          mapLocation.address is string
        );
    }

    function sparkShippingValid(data) {
      // Igual que en sparkOrderCreateValid: ya no exige
      // shipping.keys().hasOnly([...]) — esa llamada, sumada a las de más
      // arriba, alcanzaba el límite de 1000 expresiones con 3-4 productos
      // en el carrito. Un campo de más en shipping es cosmético (no hay
      // ningún código que confíe en claves fuera de las que ya se validan
      // por separado abajo).
      let shipping = data.shipping;
      return shipping is map &&
        sparkMapLocationValid(shipping.mapLocation) &&
        shipping.method is string &&
        shipping.city is string &&
        (!('departamento' in shipping) || shipping.departamento is string) &&
        shipping.address is string &&
        shipping.referencia is string &&
        (
          (
            shipping.method == 'retiro' &&
            shipping.city == 'San Lorenzo (retiro)' &&
            shipping.rateIndex == -1 &&
            data.shippingCost == 0 &&
            data.shippingPending == false
          ) ||
          (shipping.method == 'delivery' && sparkDeliveryValid(data)) ||
          (shipping.method == 'encomienda' && sparkEncomiendaValid(data))
        );
    }

    function sparkOrderCreateValid(orderId) {
      // exists(path) seguido de get(path) sobre el MISMO documento cuenta
      // como dos operaciones separadas para el límite de 1000 expresiones
      // que Firestore evalúa por escritura. Con hasta 4 productos distintos
      // por pedido (settings + usuario + guard + hasta 4 productos = hasta
      // 12 pares exists/get), un carrito de 3-4 productos ya alcanzaba ese
      // límite y el pedido se rechazaba sin ningún aviso claro de la causa
      // — el checkout quedaba roto en la práctica para cualquiera que
      // comprara más de 2 productos distintos a la vez. Sin el exists()
      // previo: si el documento no existe, get() falla la evaluación (deniega
      // igual que antes), pero cada lectura pasa a costar la mitad.
      let data = request.resource.data;
      let settingsPath = /databases/$(database)/documents/settings/general;
      let settings = get(settingsPath).data;
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let userData = get(userPath).data;
      let guardPath = checkoutGuardPath(request.auth.uid);
      let guardData = get(guardPath).data;
      let items = data.items;
      return request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email_verified == true &&
        (
          isSuperAdmin() ||
          (
            settings.get('storeOpen', false) == true &&
            userData != null &&
            userData.get('blocked', false) != true &&
            guardData != null &&
            guardData.userId == request.auth.uid &&
            guardData.lastCheckoutOrderId == orderId &&
            request.time <= guardData.lastCheckoutAt + duration.value(5, 'm')
          )
        ) &&
        // Ya no se exige data.keys().hasOnly([...]) acá: llamar .keys()/
        // hasOnly() sobre el documento completo del pedido cuesta en
        // expresiones evaluadas según la complejidad TOTAL de ese documento
        // (incluida la lista items, anidada) — con 3-4 productos distintos
        // en el carrito, esa sola llamada ya alcanzaba el límite de 1000
        // expresiones por escritura de Firestore. Un campo de más que
        // alguien logre colar no lo lee ni confía en él ningún código del
        // sitio (los campos que sí importan — precio, montos, estado,
        // permisos — siguen validados uno por uno más abajo).
        orderId == request.auth.uid + '_' + data.requestId &&
        data.userId == request.auth.uid &&
        data.userEmail.lower() == request.auth.token.email.lower() &&
        data.contactEmail is string &&
        data.userName is string && data.userName.size() >= 2 &&
        data.userPhone is string &&
        data.notes is string &&
        data.source == 'spark-checkout-v1' &&
        items is list && items.size() >= 1 && items.size() <= 4 &&
        sparkItemsUnique(items) &&
        sparkItemAtValid(items, 0, orderId) &&
        sparkItemAtValid(items, 1, orderId) &&
        sparkItemAtValid(items, 2, orderId) &&
        sparkItemAtValid(items, 3, orderId) &&
        data.subtotal ==
          sparkLineTotal(items, 0) +
          sparkLineTotal(items, 1) +
          sparkLineTotal(items, 2) +
          sparkLineTotal(items, 3) &&
        data.shippingCost is number && data.shippingCost >= 0 &&
        data.total == data.subtotal + data.shippingCost &&
        sparkShippingValid(data) &&
        data.payment is map && data.payment.keys().hasOnly(['method', 'status']) &&
        (data.payment.method == 'efectivo' || data.payment.method == 'transferencia') &&
        settings.get('paymentMethods', {}).get(data.payment.method, true) != false &&
        data.payment.status == 'pendiente' &&
        data.paymentStatus == 'pendiente' &&
        data.status == 'inventory_pending' &&
        data.notificationStatus == 'pending' &&
        data.inventoryState == 'pending' &&
        data.inventoryRevision == 0 &&
        data.inventoryUpdatedAt == request.time &&
        data.createdAt == request.time &&
        data.updatedAt == request.time;
    }

    function sparkStockUpdateValid(productId) {
      let orderId = request.resource.data.get('lastStockOrderId', 'missing-order');
      let orderPath = sparkOrderPath(orderId);
      let orderData = exists(orderPath) ? get(orderPath).data : null;
      let orderedQty = orderData != null
        ? sparkOrderQtyForProduct(orderData, productId)
        : 0;
      return isSignedIn() &&
        !isBlockedUser() &&
        orderData != null &&
        orderData.source == 'spark-checkout-v1' &&
        orderData.userId == request.auth.uid &&
        orderData.status == 'inventory_pending' &&
        orderData.inventoryState == 'pending' &&
        orderId == request.auth.uid + '_' + orderData.requestId &&
        orderedQty > 0 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'stock', 'lastStockOrderId', 'updatedAt'
        ]) &&
        resource.data.stock is number &&
        request.resource.data.stock is number &&
        request.resource.data.stock == resource.data.stock - orderedQty &&
        request.resource.data.stock >= 0 &&
        request.resource.data.updatedAt == request.time;
    }

    function sparkReservedItemValid(item, orderId) {
      let productAfter = existsAfter(sparkProductPath(item.id))
        ? getAfter(sparkProductPath(item.id)).data
        : null;
      return productAfter != null &&
        (
          productAfter.get('stock', null) == null ||
          productAfter.lastStockOrderId == orderId
        );
    }

    function sparkReservedItemAtValid(items, index, orderId) {
      return items.size() <= index || sparkReservedItemValid(items[index], orderId);
    }

    function sparkInventoryReserveValid(orderId) {
      let before = resource.data;
      let after = request.resource.data;
      let items = before.items;
      return isSignedIn() &&
        before.userId == request.auth.uid &&
        before.source == 'spark-checkout-v1' &&
        before.status == 'inventory_pending' &&
        before.inventoryState == 'pending' &&
        after.diff(before).affectedKeys().hasOnly([
          'status', 'inventoryState', 'inventoryRevision',
          'inventoryUpdatedAt', 'inventoryUpdatedBy', 'updatedAt'
        ]) &&
        after.status == 'pendiente' &&
        after.inventoryState == 'reserved' &&
        after.inventoryRevision == 1 &&
        after.inventoryUpdatedAt == request.time &&
        after.inventoryUpdatedBy == request.auth.token.email &&
        after.updatedAt == request.time &&
        sparkReservedItemAtValid(items, 0, orderId) &&
        sparkReservedItemAtValid(items, 1, orderId) &&
        sparkReservedItemAtValid(items, 2, orderId) &&
        sparkReservedItemAtValid(items, 3, orderId);
    }

    function sparkPendingOrderDeleteValid() {
      return isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        resource.data.source == 'spark-checkout-v1' &&
        resource.data.status == 'inventory_pending' &&
        resource.data.inventoryState == 'pending' &&
        // Sin este mínimo, crear+borrar el mismo orderId en loop esquivaba
        // el cooldown de checkoutGuards (que solo exige lastCheckoutOrderId
        // == orderId, y el orderId no cambia entre reintentos): el guard
        // nunca se tocaba, así que nunca se disparaba. 10s no afecta un
        // reintento real (recién se dispara si el draft cambió).
        request.time > resource.data.createdAt + duration.value(10, 's');
    }



    function orderStateReservesInventory(data) {
      let state = data.get('inventoryState', '');
      return state == 'reserved' ||
        (
          state == '' &&
          data.status != 'cancelado' &&
          data.status != 'rechazado'
        );
    }

    function staffOrderProductInventoryValid(beforeOrder, afterOrder, productId, orderId) {
      let beforeQty = orderStateReservesInventory(beforeOrder)
        ? sparkOrderQtyForProduct(beforeOrder, productId)
        : 0;
      let afterQty = orderStateReservesInventory(afterOrder)
        ? sparkOrderQtyForProduct(afterOrder, productId)
        : 0;
      let productPath = sparkProductPath(productId);
      let beforeProduct = exists(productPath) ? get(productPath).data : null;
      let afterProduct = existsAfter(productPath) ? getAfter(productPath).data : null;
      return beforeQty == afterQty ||
        (
          beforeProduct != null &&
          afterProduct != null &&
          (
            (
              beforeProduct.get('stock', null) == null &&
              afterProduct.get('stock', null) == null
            ) ||
            (
              beforeProduct.stock is number &&
              afterProduct.stock is number &&
              afterProduct.stock == beforeProduct.stock + beforeQty - afterQty &&
              afterProduct.lastInventoryOrderId == orderId &&
              (
                (afterQty > beforeQty && afterProduct.lastInventoryAction == 'reserve') ||
                (afterQty < beforeQty && afterProduct.lastInventoryAction == 'release')
              )
            )
          )
        );
    }

    function staffOrderItemInventoryAtValid(beforeOrder, afterOrder, index, orderId) {
      return beforeOrder.items.size() <= index ||
        staffOrderProductInventoryValid(
          beforeOrder,
          afterOrder,
          beforeOrder.items[index].id,
          orderId
        );
    }

    function staffOrderInventoryTransitionValid(orderId) {
      let beforeOrder = resource.data;
      let afterOrder = request.resource.data;
      let statusChanged = afterOrder.status != beforeOrder.status;
      return !statusChanged ||
        (
          afterOrder.inventoryState == (
            afterOrder.status == 'cancelado' || afterOrder.status == 'rechazado'
              ? 'released'
              : 'reserved'
          ) &&
          afterOrder.inventoryRevision is int &&
          afterOrder.inventoryRevision == beforeOrder.get('inventoryRevision', 0) + 1 &&
          afterOrder.inventoryUpdatedAt == request.time &&
          afterOrder.inventoryUpdatedBy == request.auth.token.email &&
          staffOrderItemInventoryAtValid(beforeOrder, afterOrder, 0, orderId) &&
          staffOrderItemInventoryAtValid(beforeOrder, afterOrder, 1, orderId) &&
          staffOrderItemInventoryAtValid(beforeOrder, afterOrder, 2, orderId) &&
          staffOrderItemInventoryAtValid(beforeOrder, afterOrder, 3, orderId)
        );
    }

    function adminInventoryStockUpdateValid(productId) {
      let orderId = request.resource.data.get('lastInventoryOrderId', 'missing-order');
      let orderPath = sparkOrderPath(orderId);
      let beforeOrder = exists(orderPath) ? get(orderPath).data : {};
      let afterOrder = existsAfter(orderPath) ? getAfter(orderPath).data : {};
      let beforeItems = beforeOrder.get('items', []);
      let afterItems = afterOrder.get('items', []);
      let beforeQty = beforeItems.size() > 0 && orderStateReservesInventory(beforeOrder)
        ? sparkOrderQtyForProduct(beforeOrder, productId)
        : 0;
      let afterQty = afterItems.size() > 0 && orderStateReservesInventory(afterOrder)
        ? sparkOrderQtyForProduct(afterOrder, productId)
        : 0;
      return isSignedIn() &&
        (hasRole('admin') || hasRole('agent')) &&
        beforeItems.size() > 0 &&
        afterItems.size() > 0 &&
        beforeQty != afterQty &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'stock', 'lastInventoryOrderId', 'lastInventoryAction', 'updatedAt'
        ]) &&
        resource.data.stock is number &&
        request.resource.data.stock is number &&
        request.resource.data.stock == resource.data.stock + beforeQty - afterQty &&
        request.resource.data.stock >= 0 &&
        (
          (afterQty > beforeQty && request.resource.data.lastInventoryAction == 'reserve') ||
          (afterQty < beforeQty && request.resource.data.lastInventoryAction == 'release')
        ) &&
        request.resource.data.updatedAt == request.time;
    }


    function productUpdateValid(productId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return
        (
          changed.hasOnly(['stock', 'lastStockOrderId', 'updatedAt']) &&
          sparkStockUpdateValid(productId)
        ) ||
        (
          changed.hasOnly([
            'stock', 'lastInventoryOrderId', 'lastInventoryAction', 'updatedAt'
          ]) &&
          adminInventoryStockUpdateValid(productId)
        ) ||
        (
          !changed.hasAny([
            'lastStockOrderId', 'lastInventoryOrderId', 'lastInventoryAction'
          ]) &&
          (
            isSuperAdmin() ||
            (
              isStoreOpenOrAllowed() &&
              (isAdmin() || isAgent()) &&
              currentRolePermAllows('productos', 'editar')
            )
          )
        );
    }

    /* ============================================================
       SETTINGS
       ============================================================ */

    match /settings/storeGate {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /settings/general {
      allow read: if isStoreOpenOrAllowed();
      allow write: if isSuperAdmin();
    }

    // Tarifas de envío (deliveryCities/encomiendaCities) separadas de
    // settings/general — ver sparkShippingRatesPath() más arriba.
    match /settings/shippingRates {
      allow read: if isStoreOpenOrAllowed();
      allow write: if isSuperAdmin();
    }

    match /settings/images {
      allow read: if isStoreOpenOrAllowed();
      allow write: if isSuperAdmin();
    }

    match /settings/welcomeTutorial {
      allow read: if isSignedIn() && isStoreOpenOrAllowed();
      allow write: if isSuperAdmin();
    }

    match /settings/appearance {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /settings/imageDefaults {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /settings/{docId} {
      allow read, write: if isSuperAdmin();
    }

    /* ============================================================
       BIBLIOTECA MULTIMEDIA (Super Admin → Imágenes)
       Los archivos en sí viven en Storage con su propia download URL
       pública; estos documentos son solo la metadata de administración
       (nombre, tamaño, quién subió, dónde se usa), por eso quedan
       restringidos a Super Admin igual que el resto del panel.
       ============================================================ */
    match /media/{mediaId} {
      allow read, write: if isSuperAdmin();
    }

    /* ============================================================
       APARIENCIA Y ESQUEMAS DE COLOR (Super Admin → Apariencia)
       Las páginas públicas leen por ID el esquema activo, pero no pueden
       enumerar la colección. El listado y la administración quedan
       exclusivamente en manos del Super Admin.
       ============================================================ */
    match /colorSchemes/{schemeId} {
      allow get: if true;
      allow list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();

      match /history/{entryId} {
        allow read: if isSuperAdmin();
        allow create: if isSuperAdmin();
        allow update, delete: if false;
      }
    }

    /* Editor visual: no existe acceso directo desde ningún navegador.
       El backend valida Super Admin, esquema y límites antes de usar la
       cuenta de servicio. La tienda pública recibe solo el JSON saneado. */
    match /visualBuilderPages/{pageId} {
      allow read, write: if false;
    }
    match /visualBuilderDrafts/{pageId} {
      allow read, write: if false;
    }
    match /visualBuilderHistory/{entryId} {
      allow read, write: if false;
    }

    /* ============================================================
       CHECKOUT GUARDS
       ============================================================ */


    match /checkoutGuards/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow create: if checkoutGuardWriteValid(userId);
      allow update: if checkoutGuardWriteValid(userId) &&
        (
          isSuperAdmin() ||
          request.resource.data.lastCheckoutOrderId == resource.data.lastCheckoutOrderId ||
          !('lastCheckoutAt' in resource.data) ||
          request.time > resource.data.lastCheckoutAt + duration.value(90, 's')
        );
      allow delete: if false;
    }

    /* ============================================================
       RESERVAS DE TELÉFONO
       ============================================================
       Un teléfono no puede estar en dos cuentas. El id del documento es el
       número normalizado (595981123456), así que la unicidad la garantiza
       Firestore: `allow create` sólo aplica cuando el documento NO existe,
       de modo que el segundo intento de reservar el mismo número es
       rechazado por las reglas, sin carrera posible entre dos personas
       registrándose a la vez.

       No hay `allow read` para clientas: poder leer estos documentos
       permitiría averiguar si un número tiene cuenta. El cliente no necesita
       leerlos — le alcanza con que la creación falle.

       No hay `allow update`: un número reservado no cambia de dueña. Si
       alguien cambia su teléfono, borra su reserva vieja (el número queda
       libre para quien lo herede, que es lo que pasa en la vida real) y crea
       la nueva.
       ============================================================ */

    match /phoneReservations/{phoneKey} {
      allow read: if isSuperAdmin();

      allow create: if isSignedIn() &&
        !isBlockedUser() &&
        request.resource.data.keys().hasOnly(['uid', 'createdAt']) &&
        request.resource.data.uid is string &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        phoneKey.size() >= 8 && phoneKey.size() <= 20 &&
        phoneKey.matches('^[0-9]+$');

      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;

      allow update: if false;
    }

    /* ============================================================
       USERS
       ============================================================ */

    match /users/{userId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == userId || isSuperAdmin());

      allow create: if userCreateValid(userId) && phoneIsReservedByCaller();

      allow update: if isSignedIn() && (
        (
          request.auth.uid == userId &&
          !isBlockedUser() &&
          userProfileFieldsValid() &&
          phoneIsReservedByCaller() &&
          (
            (
              isStoreOpenOrAllowed() &&
              !protectedUserFieldsChanged()
            ) ||
            loginMetadataOnlyUpdate() ||
            identityBootstrapOnlyUpdate(userId)
          )
        ) ||
        (
          isStoreOpenOrAllowed() &&
          hasRole("admin") &&
          orderStatsOnlyUpdate() &&
          orderStatsNonNegative()
        ) ||
        (
          isSuperAdmin() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['customerId']) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||
            (
              !isSuperAdminAccount(resource.data) &&
              request.resource.data.role in ['client', 'admin', 'agent', 'viewer']
            )
          )
        )
      );

      // Las cuentas se eliminan mediante tombstone desde Cloudflare; ni el
      // cliente ni Super Admin borran la identidad histórica desde el SDK.
      allow delete: if false;

      match /cart/{itemId} {
        allow read: if isSignedIn() &&
          !isBlockedUser() &&
          request.auth.uid == userId &&
          isStoreOpenOrAllowed();
        allow create, update: if isSignedIn() &&
          !isBlockedUser() &&
          request.auth.uid == userId &&
          isStoreOpenOrAllowed() &&
          cartItemValid(itemId);
        allow delete: if isSignedIn() &&
          !isBlockedUser() &&
          request.auth.uid == userId &&
          isStoreOpenOrAllowed();
      }


      match /favorites/{productId} {
        allow read: if isSignedIn() &&
          !isBlockedUser() &&
          request.auth.uid == userId &&
          isStoreOpenOrAllowed();
        // Los corazones pasan por /api/engagement. El servidor crea a la vez
        // el favorito privado y el registro administrativo, por lo que una
        // escritura directa no puede dejar ambas vistas desincronizadas.
        allow create, update, delete: if false;
      }

      match /reviews/{productId} {
        allow read: if isSignedIn() &&
          !isBlockedUser() &&
          request.auth.uid == userId &&
          isStoreOpenOrAllowed();
        allow create, update, delete: if false;
      }

      match /reviewLikeProducts/{productId} {
        allow read: if isSignedIn() &&
          !isBlockedUser() &&
          request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      match /notifications/{notificationId} {
        allow get: if isSignedIn() &&
          !isBlockedUser() &&
          request.auth.uid == userId;
        allow list: if isSignedIn() &&
          !isBlockedUser() &&
          request.auth.uid == userId &&
          request.query.limit != null &&
          request.query.limit <= 100;
        allow create, update, delete: if false;
      }
    }

    /* ============================================================
       PRODUCTS / COLLECTIONS / CONTENT
       ============================================================ */

    match /products/{productId} {
      allow get: if isStoreOpenOrAllowed();
      allow list: if isSuperAdmin() ||
        (
          isStoreOpenOrAllowed() &&
          request.query.limit != null &&
          request.query.limit <= 1000
        );

      allow create: if isSuperAdmin() ||
        (
          isStoreOpenOrAllowed() &&
          (isAdmin() || isAgent()) &&
          currentRolePermAllows('productos', 'crear')
        );

      // El checkout actual reserva stock desde Apps Script con OAuth del
      // propietario. El navegador ya no puede descontar inventario usando la
      // ruta heredada sparkStockUpdateValid().
      allow update: if adminInventoryStockUpdateValid(productId);
      allow update: if isSuperAdmin() ||
        (
          isStoreOpenOrAllowed() &&
          (isAdmin() || isAgent()) &&
          currentRolePermAllows('productos', 'editar')
        );

      allow delete: if isSuperAdmin();

      // Solo contiene la versión pública anonimizada. Nombre real, correo,
      // historial y UID viven en reviewRecords y nunca se entregan al sitio.
      match /reviews/{reviewId} {
        allow read: if isStoreOpenOrAllowed();
        allow create, update, delete: if false;
      }
    }

    match /productReviewStats/{productId} {
      allow read: if isStoreOpenOrAllowed();
      allow write: if false;
    }

    // Costos, compras, stock mÃ­nimo y notas nunca forman parte del producto
    // pÃºblico. La hoja Productos y el panel superadmin los reflejan aquÃ­.
    match /productInventory/{productId} {
      allow read, create, update, delete: if isSuperAdmin();
    }

    match /reviewRecords/{reviewId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /likeRecords/{likeId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /adminNotifications/{notificationId} {
      allow get: if isSuperAdmin();
      allow list: if isSuperAdmin() &&
        request.query.limit != null &&
        request.query.limit <= 100;
      allow create, update, delete: if false;
    }

    match /collections/{collectionId} {
      allow get: if isStoreOpenOrAllowed();
      allow list: if isSuperAdmin() ||
        (
          isStoreOpenOrAllowed() &&
          request.query.limit != null &&
          request.query.limit <= 200
        );

      allow create: if isSuperAdmin() ||
        (
          isStoreOpenOrAllowed() &&
          (isAdmin() || isAgent()) &&
          currentRolePermAllows('colecciones', 'crear')
        );

      allow update: if isSuperAdmin() ||
        (
          isStoreOpenOrAllowed() &&
          (isAdmin() || isAgent()) &&
          currentRolePermAllows('colecciones', 'editar')
        );

      allow delete: if isSuperAdmin();
    }

    match /site_content/{pageId} {
      allow get: if isStoreOpenOrAllowed();
      allow list: if isSuperAdmin();

      allow create: if isSuperAdmin() ||
        (
          isStoreOpenOrAllowed() &&
          (isAdmin() || isAgent()) &&
          (
            currentRolePermAllows('contenido', 'editarTextos') ||
            currentRolePermAllows('contenido', 'activarDesactivarSecciones')
          )
        );

      allow update: if isSuperAdmin() ||
        (
          isStoreOpenOrAllowed() &&
          (isAdmin() || isAgent()) &&
          (
            currentRolePermAllows('contenido', 'editarTextos') ||
            currentRolePermAllows('contenido', 'activarDesactivarSecciones')
          )
        );

      allow delete: if isSuperAdmin();
    }

    /* ============================================================
       ORDERS
       ============================================================ */

    match /orders/{orderId} {
      // Checkout: crea exclusivamente el servidor. La única excepción de navegador
      // es Super Admin para el CRUD manual solicitado desde el panel privado.
      allow create: if isSuperAdmin();

      allow read: if isSuperAdmin() ||
        (
          isStoreOpenOrAllowed() &&
          (
            (
              (isAdmin() || isAgent() || isViewer()) &&
              currentRolePermAllows('pedidos', 'ver')
            ) ||
            isOwnOrderByUidOrEmail()
          )
        );

      allow update: if isSuperAdmin() ||
        (
          isStoreOpenOrAllowed() &&
          (hasRole('admin') || hasRole('agent')) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'payment', 'paymentStatus', 'resendCount',
            'lastResendAt', 'notificationStatus',
            'inventoryState', 'inventoryRevision', 'inventoryUpdatedAt',
            'inventoryUpdatedBy', 'updatedAt'
          ]) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
            currentRolePermAllows('pedidos', 'cambiarEstado')
          ) &&
          staffOrderInventoryTransitionValid(orderId) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['payment', 'paymentStatus']) ||
            currentRolePermAllows('pedidos', 'cambiarPago')
          ) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'resendCount', 'lastResendAt', 'notificationStatus'
            ]) ||
            currentRolePermAllows('pedidos', 'reenviarCorreo')
          )
        );

      allow delete: if isSuperAdmin();
    }

    match /orderTrash/{orderId} {
      allow read, create, update, delete: if isSuperAdmin();
    }

    /* ============================================================
       AUDIT / PERMISSIONS
       ============================================================ */

    match /auditLog/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin() ||
        (
          isStoreOpenOrAllowed() &&
          (hasRole("admin") || hasRole("agent"))
        );
      allow update, delete: if false;
    }

    match /rolePermissions/{docId} {
      allow read: if isSuperAdmin() ||
        (
          isStoreOpenOrAllowed() &&
          (
            hasRole("admin") ||
            hasRole("agent") ||
            hasRole("viewer") ||
            hasRole("moderator") ||
            hasRole("support")
          )
        );
      allow write: if isSuperAdmin();
    }

    /* ============================================================
       EMAIL MODULE
       ============================================================ */

    match /emailSettings/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /emailTemplates/{templateId} {
      allow read, write: if isSuperAdmin();
    }

    match /emailLogs/{logId} {
      allow read: if isSuperAdmin();

      allow create: if isSuperAdmin() ||
        (
          isStoreOpenOrAllowed() &&
          (
            (
              (hasRole("admin") || hasRole("agent")) &&
              currentRolePermAllows('pedidos', 'reenviarCorreo')
            ) ||
            (
              isSignedIn() &&
              !isBlockedUser() &&
              request.resource.data.keys().hasOnly([
                'category', 'type', 'recipient', 'status', 'orderId',
                'isAutomatic', 'duplicate', 'attempts', 'sentBy', 'error', 'sentAt'
              ]) &&
              request.resource.data.category == 'pedido' &&
              request.resource.data.type == 'pedido_nuevo' &&
              request.resource.data.orderId is string &&
              request.resource.data.sentBy == request.auth.token.email &&
              request.resource.data.recipient is string &&
              request.resource.data.recipient.size() <= 254 &&
              request.resource.data.status in ['sent', 'failed', 'partial', 'pending'] &&
              request.resource.data.isAutomatic is bool &&
              request.resource.data.duplicate is bool &&
              request.resource.data.attempts is number &&
              request.resource.data.error is string &&
              request.resource.data.error.size() <= 500 &&
              request.resource.data.sentAt == request.time &&
              get(
                /databases/$(database)/documents/orders/$(request.resource.data.orderId)
              ).data.userId == request.auth.uid
            )
          )
        );

      allow update, delete: if false;
    }

    match /emailCampaigns/{campaignId} {
      allow read, create, update: if isSuperAdmin();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
