# TINTIN WEB — variables de ejemplo para procesos privados o despliegues externos.
# La web pública de GitHub Pages NO consume este archivo.
# Nunca coloques secretos en HTML, CSS, js/ ni en archivos versionados.

# Firebase público: los identificadores del SDK web no sustituyen las reglas de seguridad.
FIREBASE_PROJECT_ID=tintin-accesorios

# PayPal Checkout: mantener PAYPAL_ENABLED=false hasta definir la tasa comercial,
# crear credenciales y registrar el webhook en Cloudflare.
PAYPAL_ENABLED=false
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_SETTLEMENT_CURRENCY=USD
PAYPAL_PYG_PER_USD=
PAYPAL_RATE_UPDATED_AT=

# Scripts y workflows de CI que consultan la API de GitHub.
GITHUB_TOKEN=
GITHUB_REPOSITORY=tintinaccs/tintin-web
CLOUDFLARE_PAGES_PROJECT=tintinaccesorios
