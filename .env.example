# TINTIN WEB — variables de ejemplo para procesos privados o despliegues externos.
# La web pública de GitHub Pages NO consume este archivo.
# Nunca coloques secretos en HTML, CSS, js/ ni en archivos versionados.

# Firebase público: los identificadores del SDK web no sustituyen las reglas de seguridad.
FIREBASE_PROJECT_ID=tintin-accesorios

# Configuración exclusiva de funciones o automatizaciones privadas.
# Completar únicamente en el proveedor que ejecute el backend.
EMAIL_SENDER=
EMAIL_PROVIDER_API_KEY=
ORDER_WEBHOOK_SHARED_SECRET=

# Integraciones de pago: siempre del lado del servidor.
PAYMENT_PUBLIC_KEY=
PAYMENT_PRIVATE_KEY=
PAYMENT_WEBHOOK_SECRET=

# PayPal Checkout: mantener PAYPAL_ENABLED=false hasta definir la tasa comercial,
# crear credenciales y registrar el webhook en Cloudflare.
PAYPAL_ENABLED=false
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_SETTLEMENT_CURRENCY=USD
PAYPAL_PYG_PER_USD=
PAYPAL_RATE_UPDATED_AT=

# Observabilidad privada, cuando se habilite un proveedor externo.
ERROR_REPORTING_DSN=
GITHUB_TOKEN=
GITHUB_REPOSITORY=tintinaccs/tintin-web
GITHUB_BASE_BRANCH=main
CLOUDFLARE_PAGES_PROJECT=tintinaccesorios

# Estudio de Código Tintin — EXCLUSIVO del backend de Cloudflare.
# Usar una GitHub App instalada solo en el repositorio, nunca un PAT del navegador.
CODE_STUDIO_GITHUB_APP_ID=
CODE_STUDIO_GITHUB_INSTALLATION_ID=
CODE_STUDIO_GITHUB_APP_PRIVATE_KEY=
CODE_STUDIO_GITHUB_REPOSITORY=tintinaccs/tintin-web
CODE_STUDIO_GITHUB_WEBHOOK_SECRET=
CODE_STUDIO_FIREBASE_PROJECT_ID=tintin-accesorios
CODE_STUDIO_EXTERNAL_ALLOWED_HOSTS=console.firebase.google.com,dash.cloudflare.com,github.com,docs.github.com,tintinaccesorios.pages.dev

# Asistente IA opcional. El endpoint debe ser HTTPS y su host estar en la allowlist.
# La IA solo analiza/proporciona propuestas; no aprueba, fusiona ni publica.
CODE_STUDIO_AI_ENDPOINT=
CODE_STUDIO_AI_TOKEN=
CODE_STUDIO_AI_MODEL=
CODE_STUDIO_AI_ALLOWED_HOSTS=

# Notificaciones push del panel (Firebase Cloud Messaging Web Push).
# Se configuran en Cloudflare Pages → Settings → Variables and Secrets.
FIREBASE_WEB_PUSH_VAPID_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
TINTIN_PUSH_WEBHOOK_SECRET=
TINTIN_PUSH_ENABLED=false
